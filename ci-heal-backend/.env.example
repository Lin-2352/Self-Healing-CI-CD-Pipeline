# Copy to .env and replace the placeholders. Never commit .env.
# Names here must match Settings in app/config.py. A test fails if they drift.

# Process
APP_NAME=ci-heal-backend
APP_ENV=dev
LOG_LEVEL=INFO

# Writes stay off until this is false. Dry-run decisions never receive a real CI outcome.
DRY_RUN=true

# Fine-grained PAT or a GitHub App token. Not the Actions GITHUB_TOKEN.
GITHUB_TOKEN=replace-me
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT=30
GITHUB_MAX_RETRIES=2
GITHUB_MAX_FILE_BYTES=100000
GITHUB_MAX_LOG_BYTES=1000000
GITHUB_DEFAULT_BRANCH=main
GITHUB_WEBHOOK_SECRET=replace-me
# Login of the token owner. Runs by this actor are ignored, except ai-fix verification.
GITHUB_BOT_LOGIN=
N8N_SHARED_TOKEN=replace-me
# Required outside dev on /failures, /decisions, /stats, and reprocess.
API_TOKEN=replace-me
# Comma-separated owner/name. Empty allows no repository.
ALLOWED_REPOS=acme/demo
WEBHOOK_MAX_BYTES=1000000
PIPELINE_TIMEOUT_SECONDS=180
PROCESSING_STALE_SECONDS=900
MAX_RECOVERIES=3

# sqlite for a demo. Use hosted Postgres on Render/Railway; free-tier disk is ephemeral.
DATABASE_URL=sqlite:///./ci_heal.db

# Decision gates. 0.75 makes a 2/3 classifier vote escalate.
CLASSIFY_THRESHOLD=0.75
AGREEMENT_THRESHOLD=0.6
FLAKY_THRESHOLD=0.75
MAX_RETRIES=1
MAX_HEAL_ATTEMPTS=3
CATEGORY_THRESHOLDS={}

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Classifier role. mock needs no key. http is Kaggle, Groq, or Gemini.
# Kaggle:  CLASSIFIER_LLM_BASE_URL=https://your-tunnel.trycloudflare.com
#          CLASSIFIER_LLM_API_KEY=<the token the Kaggle server expects>
#          CLASSIFIER_LLM_MODEL=local
# Groq:    CLASSIFIER_LLM_BASE_URL=https://api.groq.com/openai/v1
#          CLASSIFIER_LLM_MODEL=llama-3.3-70b-versatile
# Gemini:  CLASSIFIER_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#          CLASSIFIER_LLM_MODEL=gemini-2.0-flash
CLASSIFIER_LLM_PROVIDER=mock
CLASSIFIER_LLM_BASE_URL=
CLASSIFIER_LLM_API_KEY=
CLASSIFIER_LLM_MODEL=local
CLASSIFIER_LLM_TIMEOUT=60
CLASSIFIER_LLM_DEADLINE=180
CLASSIFIER_LLM_STREAM=true
CLASSIFIER_LLM_MAX_RETRIES=2
CLASSIFIER_SAMPLES=1
CLASSIFIER_TEMPERATURE=0
CLASSIFIER_MAX_RETRIES=2
CLASSIFIER_MAX_TOKENS=512

# Fixer role. Point this at Kaggle when the classifier uses a smaller hosted model.
FIXER_LLM_PROVIDER=mock
FIXER_LLM_BASE_URL=
FIXER_LLM_API_KEY=
FIXER_LLM_MODEL=local
FIXER_LLM_TIMEOUT=120
FIXER_LLM_DEADLINE=360
FIXER_LLM_STREAM=true
FIXER_LLM_MAX_RETRIES=2
FIX_CANDIDATES=3
FIX_TEMPERATURE=0.7
FIX_MAX_TOKENS=4096
FIX_MAX_EDITS=5
FIX_MAX_CHANGED_LINES=50
FIX_ALLOW_WORKFLOWS=false
